# Copy to .env.local for local development.

# API mode: controls where the app fetches data
# "mock" -> MSW (Mock Service Worker) intercepts every request, no backend needed.
#           This is the default for local development and requires NEXT_PUBLIC_API_MODE=mock.
#           The value is baked into the build at compile time.
# "live" -> Requests are proxied to BACKEND_URL via next.config.ts rewrites.
#           Used in Docker images built with docker-compose. The Dockerfile enforces
#           NEXT_PUBLIC_API_MODE=live at build time, so this .env.local is ignored there.
NEXT_PUBLIC_API_MODE=mock

# Backend URL: only read server-side (Route Handlers, RSC fetches, next.config.ts rewrites).
# Local development: http://localhost:8080
# Docker compose stack: http://backend:8080
# NOTE: This is a server-side variable and is NOT embedded in the client bundle.
BACKEND_URL=http://localhost:8080
